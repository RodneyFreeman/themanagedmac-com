---
interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  featured?: boolean;
}

const { href, title, description, pubDate, tags = [], featured = false } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a href={href} class:list={['card post-card', { featured }]}>
  <div class="post-meta">
    <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    {tags.length > 0 && <span class="dot" aria-hidden="true">·</span>}
    {tags.slice(0, 2).map((tag) => <span class="badge">{tag}</span>)}
  </div>
  <h3>{title}</h3>
  <p class="text-secondary">{description}</p>
  <span class="link-arrow">Read more <span class="arrow">→</span></span>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
  }

  .post-card.featured {
    padding: var(--space-6);
    background: var(--color-bg-secondary);
    border-color: transparent;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.8125rem;
    color: var(--color-text-tertiary);
  }

  .dot {
    color: var(--color-border);
  }

  .post-card h3 {
    line-height: 1.3;
  }

  .post-card p {
    flex: 1;
  }
</style>
