---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ResourceCard from '../components/ResourceCard.astro';

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const featuredResources = [
  {
    title: 'Automated Device Enrollment, start to finish',
    description: 'Mapping ABM tokens, enrollment profiles, and DEP to a zero-touch onboarding flow.',
    href: '/resources/',
    category: 'Deployment',
    categoryColor: 'var(--cat-deployment)',
  },
  {
    title: 'Declarative Device Management explained',
    description: 'What DDM changes about how MDM commands are delivered, and where the gaps still are.',
    href: '/resources/',
    category: 'MDM',
    categoryColor: 'var(--cat-mdm)',
  },
  {
    title: 'Shell scripts every Mac admin should have',
    description: 'A working set of scripts for compliance checks, cleanup, and reporting.',
    href: '/resources/',
    category: 'Scripting',
    categoryColor: 'var(--cat-scripting)',
  },
];
---

<BaseLayout title="The Managed Mac">
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Apple device management, in practice</p>
      <h1>Keeping Apple fleets managed, secure, and out of the way.</h1>
      <p class="lede hero-lede">
        Field notes, guides, and scripts from an Applications &amp; Systems
        Administrator working with MDM, Apple Business Manager, and everything
        that keeps Macs and iPhones enrolled and compliant — written from
        Carmel, Indiana.
      </p>
      <div class="cluster hero-actions">
        <a href="/blog/" class="btn btn-primary">Read the blog</a>
        <a href="/resources/" class="btn btn-secondary">Browse resources</a>
      </div>
    </div>
  </section>

  <!-- Latest posts -->
  <section class="section-tight">
    <div class="container">
      <div class="section-header">
        <h2>Latest posts</h2>
        <a href="/blog/" class="link-arrow">View all <span class="arrow">→</span></a>
      </div>

      {latestPosts.length > 0 ? (
        <div class="grid grid-3">
          {latestPosts.map((post) => (
            <PostCard
              href={`/blog/${post.slug}/`}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
            />
          ))}
        </div>
      ) : (
        <p class="text-secondary">First post coming soon.</p>
      )}
    </div>
  </section>

  <!-- Focus areas -->
  <section class="section-tight bg-secondary">
    <div class="container">
      <div class="section-header">
        <h2>What this site covers</h2>
      </div>
      <div class="grid grid-3">
        <div class="focus-card">
          <h3>MDM &amp; enrollment</h3>
          <p class="text-secondary">
            Jamf Pro, Apple Business Manager, Automated Device Enrollment, and
            Declarative Device Management — how the pieces fit together.
          </p>
        </div>
        <div class="focus-card">
          <h3>Scripting &amp; automation</h3>
          <p class="text-secondary">
            Shell and Swift scripting, self-service tooling, and automating the
            repetitive parts of fleet administration.
          </p>
        </div>
        <div class="focus-card">
          <h3>Security &amp; compliance</h3>
          <p class="text-secondary">
            Baselines, patch management, and practical approaches to keeping a
            fleet audit-ready without slowing anyone down.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Resources teaser -->
  <section class="section-tight">
    <div class="container">
      <div class="section-header">
        <h2>From the resources library</h2>
        <a href="/resources/" class="link-arrow">See all guides <span class="arrow">→</span></a>
      </div>
      <div class="grid grid-3">
        {featuredResources.map((resource) => (
          <ResourceCard {...resource} />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-tight">
    <div class="container">
      <div class="cta card">
        <div>
          <h2>Get new posts by email or RSS</h2>
          <p class="text-secondary">
            No newsletter spam — just new guides and posts as they're published.
          </p>
        </div>
        <div class="cluster cta-actions">
          <a href="/contact/" class="btn btn-primary">Get in touch</a>
          <a href="/rss.xml" class="btn btn-secondary">RSS feed</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-9) var(--space-8);
    text-align: center;
    background:
      radial-gradient(60% 60% at 50% 0%, color-mix(in srgb, var(--color-accent) 8%, transparent), transparent);
  }

  .hero-inner {
    max-width: 760px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .hero h1 {
    margin-top: var(--space-2);
  }

  .hero-lede {
    max-width: 600px;
  }

  .hero-actions {
    margin-top: var(--space-3);
    gap: var(--space-3);
    justify-content: center;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-6);
    gap: var(--space-4);
  }

  .focus-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
    background: var(--color-bg-secondary);
    border: none;
  }

  .cta-actions {
    gap: var(--space-3);
  }

  @media (max-width: 640px) {
    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
