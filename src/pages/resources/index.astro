---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceCard from '../../components/ResourceCard.astro';

const categories = [
  {
    name: 'MDM & Enrollment',
    color: 'var(--cat-mdm)',
    items: [
      {
        title: 'Apple Business Manager setup checklist',
        description: 'Federated authentication, MDM server tokens, and organizing locations before you enroll a single device.',
        href: '/blog/',
      },
      {
        title: 'Declarative Device Management explained',
        description: 'How DDM shifts MDM from imperative commands to device-reported status, and what still relies on the legacy protocol.',
        href: '/blog/',
      },
      {
        title: 'Automated Device Enrollment, start to finish',
        description: 'Mapping ABM tokens, enrollment profiles, and DEP to a true zero-touch onboarding flow.',
        href: '/blog/',
      },
    ],
  },
  {
    name: 'Scripting & Automation',
    color: 'var(--cat-scripting)',
    items: [
      {
        title: 'Shell scripts every Mac admin should have',
        description: 'A working set of scripts for compliance checks, cleanup tasks, and self-service reporting.',
        href: '/blog/',
      },
      {
        title: 'Building Self Service automations',
        description: 'Patterns for packaging scripts and workflows so end users can safely trigger them themselves.',
        href: '/blog/',
      },
    ],
  },
  {
    name: 'Security & Compliance',
    color: 'var(--cat-security)',
    items: [
      {
        title: 'Baselining a Mac fleet against CIS benchmarks',
        description: 'Turning a security baseline into enforceable configuration profiles without breaking workflows.',
        href: '/blog/',
      },
      {
        title: 'Patch management without the chaos',
        description: 'Staggered deferrals, deadline enforcement, and reporting on update compliance across a fleet.',
        href: '/blog/',
      },
    ],
  },
  {
    name: 'Deployment & Tooling',
    color: 'var(--cat-deployment)',
    items: [
      {
        title: 'Choosing between Jamf, Mosyle, and Kandji',
        description: 'A practical comparison from someone who has run more than one of them in production.',
        href: '/blog/',
      },
      {
        title: 'Zero-touch imaging is dead — here is what replaced it',
        description: 'Moving from monolithic images to declarative, app-based provisioning.',
        href: '/blog/',
      },
    ],
  },
];
---

<BaseLayout
  title="Resources"
  description="A categorized library of guides on MDM, scripting, security, and deployment for Apple device management."
>
  <section class="section-tight">
    <div class="container">
      <header class="page-header">
        <p class="eyebrow">Resources</p>
        <h1>A working library, not a link dump</h1>
        <p class="lede">
          Guides organized by the problem they solve — enrollment, automation,
          security, and deployment — kept current as Apple's tools change.
        </p>
      </header>

      {categories.map((category) => (
        <div class="category-block">
          <h2 style={`color:${category.color}`}>{category.name}</h2>
          <div class="grid grid-3">
            {category.items.map((item) => (
              <ResourceCard
                title={item.title}
                description={item.description}
                href={item.href}
                category={category.name.split(' ')[0]}
                categoryColor={category.color}
              />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    max-width: var(--max-width-narrow);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .category-block {
    margin-bottom: var(--space-8);
  }

  .category-block:last-child {
    margin-bottom: 0;
  }

  .category-block h2 {
    font-size: 1.375rem;
    margin-bottom: var(--space-5);
  }
</style>
